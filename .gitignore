# Credenziali e configurazioni sensibili
.env
.env.locale

# Ambiente locale di prova (strumenti/locale)
strumenti/locale/www/

# Cache runtime (file generati automaticamente)
# Tutto il contenuto di cache/ tranne i file che servono alla cartella stessa
cache/*
!cache/.gitkeep
!cache/.htaccess

# Uploads utenti (non versionare file caricati)
uploads/*
!uploads/.gitkeep
uploads/allegati_prenotazioni/*
!uploads/allegati_prenotazioni/.gitkeep

# File di debug (non pubblicare)
debug_saml.php

# IDE e OS
.idea/
.vscode/
*.DS_Store
Thumbs.db
desktop.ini
Desktop.ini

# PHP
*.log
php_errors.log

# Composer (se aggiunto in futuro)
/vendor/
composer.lock
.claude/

# Pacchetti per il caricamento sul server
*.tgz
.php-cs-fixer.cache
.phpunit.result.cache

# Materiali di lavoro con dati personali (modelli e verbali veri): non versionare
materiali/

# Pacchetti di aggiornamento e controlli sul server (si costruiscono quando servono, non si versionano)
/aggiornamento_*.zip
/mappa_sito_*.zip
/inventario_*.txt
/controllo_*.txt

# Materiale di lavoro che resta solo sul disco (piani, appunti, schermate, note di prova, connettore Python di riferimento)
/documentazione/piano_*.md
/documentazione/analisi_portale_*.md
/documentazione/roadmap_ux_*.md
/documentazione/mappa_nuove_feature.txt
/documentazione/mappa_pannello.html
/documentazione/mockup_tutorato_pagamenti.html
/documentazione/schermate/
/documentazione/anteprime_attestati/
/documentazione/anteprime_tutorato/
/difetti/
/protocollo/*
!/protocollo/.htaccess
!/protocollo/php-titulus-utility/
